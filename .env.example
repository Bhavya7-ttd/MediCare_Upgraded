# Firebase Functions & Environment Configuration Example
# Note: Google Gemini AI uses per-user API keys stored in browser localStorage.
# No developer Gemini secret is required on the server.

# Twilio Configuration (Optional - for SMS fallback on Emergency SOS)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

